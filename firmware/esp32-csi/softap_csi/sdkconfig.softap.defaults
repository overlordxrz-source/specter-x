# The SoftAP role: the board is the access point and the Mac is the station.
# Built with:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.softap.defaults" \
#          -B build-softap build
CONFIG_SPECTER_ROLE_SOFTAP=y
CONFIG_SPECTER_ROLE_STATION=n
CONFIG_SPECTER_LAB_SSID="SPECTER-LAB"
CONFIG_SPECTER_LAB_CHANNEL=6
