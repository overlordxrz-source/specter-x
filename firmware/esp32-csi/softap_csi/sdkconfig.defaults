# The target is part of the recipe, not of the shell environment. On a
# clean checkout without this line idf.py silently builds for the ORIGINAL
# ESP32 (bootloader at 0x1000, entry point 0x4008xxxx), which is not this
# board and would not boot.
CONFIG_IDF_TARGET="esp32s3"

# --- flash --------------------------------------------------------------
# The board has 16 MB (verified with esptool). The default would say 2 MB,
# and `idf.py flash` would then patch the bootloader header to 2 MB.
# The experiment flashes the APP only, but the build should still describe
# the hardware it is built for.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- Wi-Fi -------------------------------------------------------------------
CONFIG_ESP32_WIFI_CSI_ENABLED=y
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# --- console -----------------------------------------------------------------
# The console stays on UART0 at 921600. That is the channel the host reads
# the device's own log from, and it is how a stall is diagnosed.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD_921600B=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600

# --- system ------------------------------------------------------------------
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_COMPILER_OPTIMIZATION_PERF=y
